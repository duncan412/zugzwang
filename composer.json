{
    "name": "developful/zugzwang",
    "type": "project",
    "license": "GPL-3.0-or-later",
    "autoload": {
        "psr-4": {
            "Developful\\Zugzwang\\": "src/"
        }
    },
    "minimum-stability": "dev",
    "require": {
        "slim/slim": "4.15.3",
        "slim/psr7": "1.8.0",
        "vlucas/phpdotenv": "5.7.0",
        "jimtools/jwt-auth": "3.0.1",
        "php-di/php-di": "7.1.1",
        "firebase/php-jwt": "7.2.0",
        "league/fractal": "0.21"
    },
    "require-dev": {
        "phpstan/phpstan": "2.3.x-dev",
        "pestphp/pest": "5.x-dev"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
